{
  "name": "bff",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-Frontend: handles the OIDC Authorization Code + PKCE flow with any provider and issues an HttpOnly session cookie to the SPA.",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "openid-client": "^5.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
