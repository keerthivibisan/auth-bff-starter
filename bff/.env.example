# --- Server ---
PORT=3001
NODE_ENV=development

# Public origin of the SPA (used for post-login/post-logout redirects and CORS).
APP_BASE_URL=http://localhost:5173
# Public origin of this BFF (used to build the OIDC redirect_uri).
BFF_BASE_URL=http://localhost:3001

# --- Session cookie ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=bff_session
SESSION_MAX_AGE_MS=28800000
# Set to true in production (requires HTTPS).
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax

# --- OIDC provider ---
# Any standards-compliant OIDC provider works: Keycloak, Auth0, Okta,
# Azure AD / Entra ID, Google, etc. — only OIDC discovery, Authorization
# Code + PKCE, and refresh tokens are assumed.
#
# Issuer URL — must serve {issuer}/.well-known/openid-configuration.
#   Keycloak:  http://localhost:8080/realms/app-realm
#   Auth0:     https://YOUR_TENANT.auth0.com/
#   Okta:      https://YOUR_ORG.okta.com/oauth2/default
#   Azure AD:  https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_ISSUER_URL=http://localhost:8080/realms/app-realm
OIDC_SCOPES=openid profile email

# Confidential client used for the login flow. Must have PKCE (S256) enabled
# and "Authorization Code" flow enabled, with a redirect URI matching
# OIDC_REDIRECT_URI below.
OIDC_LOGIN_CLIENT_ID=app-bff
OIDC_LOGIN_CLIENT_SECRET=change-me

# Optional: a separate client/flow for signup. Defaults to the login client
# above if left unset.
#OIDC_SIGNUP_CLIENT_ID=app-bff-signup
#OIDC_SIGNUP_CLIENT_SECRET=change-me

# Defaults to {BFF_BASE_URL}/api/auth/callback if unset.
#OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback
# Defaults to APP_BASE_URL if unset.
#OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# --- Signup routing ---
# How the "Sign up" button reaches a different screen than "Login" at the
# provider — there's no OIDC standard for this, so pick what matches yours.
#
#   endpoint       (default) Use a distinct authorization endpoint for
#                  signup. Matches Keycloak's convention out of the box
#                  (swaps ".../auth" for ".../registrations" — see
#                  OIDC_SIGNUP_ENDPOINT_SEGMENT), or set
#                  OIDC_SIGNUP_AUTHORIZATION_ENDPOINT to override outright.
#   param          Append a query param to the normal authorization URL,
#                  e.g. Auth0's screen_hint=signup.
#   same-as-login  No special handling — Signup behaves exactly like Login.
#                  Use this when your provider has no redirect-based
#                  self-registration.
OIDC_SIGNUP_MODE=endpoint
#OIDC_SIGNUP_ENDPOINT_SEGMENT=registrations
#OIDC_SIGNUP_AUTHORIZATION_ENDPOINT=https://YOUR_TENANT.auth0.com/authorize
#OIDC_SIGNUP_PARAM=screen_hint=signup
