# --- Server ---
PORT=3001
NODE_ENV=development

# Public origin of the SPA (used for post-login/post-logout redirects and CORS).
APP_BASE_URL=http://localhost:5173
# Public origin of this BFF (used to build the OIDC redirect_uri).
BFF_BASE_URL=http://localhost:3001

# --- Session cookie ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=bff_session
SESSION_MAX_AGE_MS=28800000
# Set to true in production (requires HTTPS).
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax

# --- Keycloak ---
# Realm issuer URL, e.g. http://localhost:8080/realms/app-realm
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/app-realm
KEYCLOAK_SCOPES=openid profile email

# Confidential client used for the login flow. Must have PKCE (S256) enabled
# and "Standard flow" enabled in Keycloak, with a redirect URI matching
# KEYCLOAK_REDIRECT_URI below.
KEYCLOAK_LOGIN_CLIENT_ID=app-bff
KEYCLOAK_LOGIN_CLIENT_SECRET=change-me

# Optional: a separate client/flow for signup. Defaults to the login client
# above if left unset, in which case signup uses Keycloak's registration
# endpoint for the same client.
#KEYCLOAK_SIGNUP_CLIENT_ID=app-bff-signup
#KEYCLOAK_SIGNUP_CLIENT_SECRET=change-me

# Defaults to {BFF_BASE_URL}/api/auth/callback if unset.
#KEYCLOAK_REDIRECT_URI=http://localhost:3001/api/auth/callback
# Defaults to APP_BASE_URL if unset.
#KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
